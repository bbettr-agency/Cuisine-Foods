# Cuisine Foods — environment variables
# Copy to .env.local for local dev; set the real values in Vercel (never commit .env).

# Public site URL (used for canonical URLs, sitemap, OG tags).
NEXT_PUBLIC_SITE_URL=https://cuisinefoods.co.za

# --- Custom quote form (/api/quote) – SERVER-ONLY, never prefix with NEXT_PUBLIC_ ---
# GoHighLevel Private Integration token (scopes: contacts.write, contacts.readonly).
# Leave empty and the form refuses submissions honestly instead of pretending.
GHL_API_TOKEN=
# OPTIONAL override. Defaults to cuisine-custom-form-submitted (both entry workflows listen for it).
GHL_TRIGGER_TAG=
# OPTIONAL override. The "Estimated used oil per month" field ID is already in config/quote-form.ts.
GHL_FIELD_UCO_VOLUME=
# OPTIONAL override. The "Website attribution" field ID is already in config/quote-form.ts.
GHL_FIELD_ATTRIBUTION=
# Meta Pixel on the custom form (existing pixel 2662434760785009). Preview builds of
# feat/custom-form switch it on automatically (next.config.js). Set to "true" only to
# enable it somewhere else on purpose, e.g. production after approval.
NEXT_PUBLIC_META_PIXEL_ENABLED=
# ROLLBACK SWITCH: "ghl" puts every funnel back on the official GoHighLevel form (redeploy needed).
NEXT_PUBLIC_QUOTE_FORM_MODE=

# --- WhatsApp lead popup (/api/whatsapp-lead) – SERVER-ONLY ---
# GoHighLevel inbound webhook that receives the popup's five fields. Set it in Vercel
# (Preview and Production). Never commit the real address and never prefix it NEXT_PUBLIC_.
# Leave empty and the popup reports a failure honestly and offers to continue to WhatsApp.
GHL_WHATSAPP_WEBHOOK_URL=
