# Cuisine Foods — environment variables
# Copy to .env.local for local dev; set the real values in Vercel (never commit .env).

# Public site URL (used for canonical URLs, sitemap, OG tags).
NEXT_PUBLIC_SITE_URL=https://cuisinefoods.co.za

# --- Custom quote form (/api/quote) – SERVER-ONLY, never prefix with NEXT_PUBLIC_ ---
# GoHighLevel Private Integration token (scopes: contacts.write, contacts.readonly).
# Leave empty and the form refuses submissions honestly instead of pretending.
GHL_API_TOKEN=
# Tag applied after a successful save; the lead workflow's added "Tag Added" trigger listens for it.
GHL_TRIGGER_TAG=cuisine-custom-form-submitted
# ID of the new "Estimated used oil per month" custom field, once created in GHL.
GHL_FIELD_UCO_VOLUME=
# OPTIONAL: ID of ONE text custom field for campaign attribution (UTMs + Meta click ids).
# Leave empty and attribution is captured in the browser but not stored in GHL.
GHL_FIELD_ATTRIBUTION=
# Meta Pixel on the custom form (existing pixel 2662434760785009). "true" turns it on
# for that Vercel environment; anything else leaves it off. Needs approval first.
NEXT_PUBLIC_META_PIXEL_ENABLED=
